{
  // Tally — one Worker: static assets + /api/* via Hono.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  // The client bundle is an ASSET, not part of the Worker's module graph, so
  // nothing else forces it to exist: `wrangler deploy` / `versions upload`
  // fail on a missing assets.directory unless something built it first.
  // Owning that here means every path builds it — the production deploy, a
  // PR's `versions upload` preview (which runs no build command of its own),
  // and `wrangler dev`, which otherwise serves a stale dist/client.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/login"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally",
      "database_id": "b89462c1-af9b-46a1-bb05-0579b793ab25",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "tally-receipts"
    }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "myteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "web-1rs-pages.cloudflareaccess.com",
    // The Access application AUD tag (Zero Trust → Access → Applications → your app → Overview)
    "ACCESS_AUD": "d640f5add8f1f14518269321fe5796237722992a7ba1192c5ce0311f72d36775",
    // Cloudflare account id + AI Gateway id for Anthropic extraction calls (M2)
    "AI_GATEWAY_ACCOUNT_ID": "0bda3a2560ca48711ef7336cc421abed",
    "AI_GATEWAY_ID": "tally"
  }
  // Secrets (never in this file): ANTHROPIC_API_KEY via `wrangler secret put ANTHROPIC_API_KEY`
}
