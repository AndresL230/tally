{
  // Tally — one Worker: static assets + /api/* via Hono.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally",
      "database_id": "b89462c1-af9b-46a1-bb05-0579b793ab25",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS",
      "bucket_name": "tally-receipts"
    }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "myteam.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "REPLACE-ME.cloudflareaccess.com",
    // The Access application AUD tag (Zero Trust → Access → Applications → your app → Overview)
    "ACCESS_AUD": "REPLACE-ME",
    // Cloudflare account id + AI Gateway id for Anthropic extraction calls (M2)
    "AI_GATEWAY_ACCOUNT_ID": "REPLACE-ME",
    "AI_GATEWAY_ID": "REPLACE-ME"
  }
  // Secrets (never in this file): ANTHROPIC_API_KEY via `wrangler secret put ANTHROPIC_API_KEY`
}
